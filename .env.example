# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospitami?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Providers
GEMINI_API_KEY="your-gemini-api-key"
KIMI_API_KEY="your-kimi-api-key"

# Email Sending & Receiving (SMTP / IMAP)
SMTP_HOST="smtp.your-mail-server.com"
SMTP_PORT="587"
SMTP_USER="outreach@venuewrangler.com"
SMTP_PASS="your-email-password"
IMAP_HOST="imap.your-mail-server.com"
IMAP_PORT="993"
IMAP_USER="outreach@venuewrangler.com"
IMAP_PASS="your-email-password"

# Email Tracking (generate with: openssl rand -hex 32)
TRACKING_SECRET="your-32-byte-hex-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Analytics
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Background Jobs (Trigger.dev)
TRIGGER_API_KEY="your-trigger-api-key"
TRIGGER_API_URL="https://api.trigger.dev"

# Development: skip Supabase auth and use a hardcoded workspace
# SUPABASE_AUTH_DISABLED="true"
# DEMO_WORKSPACE_ID="your-workspace-uuid"
# NEXT_PUBLIC_DEMO_WORKSPACE_ID="your-workspace-uuid"
